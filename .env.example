# Optional public collection API keys. Copy this file to .env and restart.
# Never place keys in dist or commit .env.
SMITHSONIAN_API_KEY=
# eMuseum also requires source-schema / rights validation before activation.
EMUSEUM_API_KEY=

# Optional deployment settings (defaults keep the app local).
# HOST=0.0.0.0
# PORT=10000
# PUBLIC_ORIGIN=https://your-domain.example
# DATA_DIR=/path/to/persistent/data
# Render supplies RENDER_EXTERNAL_URL automatically.
